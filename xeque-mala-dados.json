{
  "versao": 1,
  "_leia_me": {
    "onde": "mao = obrigatório na mochila (lítio, documentos, remédios) | mala = vai na mala despachada, ou na mochila 2 quando não há despacho | corpo = vestido no voo, não pesa",
    "qtd": "Use um número fixo, ou um objeto de regra. Campos da regra: escala (fixo|dias|lavagem|pessoas|notebooks|lavagens), fator (multiplica a escala), mais (soma depois), min, max, max_merino (substitui max quando merino ligado), max_sem_lavar (substitui max quando não lava), mais_se_quente.",
    "escalas": "dias = dias totais | lavagem = dias efetivos de roupa em circulação, limitado pelo ciclo de lavagem | pessoas = 1 ou 2 conforme o filtro | notebooks = 1 ou 2 | lavagens = número de lavagens na viagem",
    "condicoes": "clima = array com frio/ameno/quente em que o item aparece | requer_menor = só aparece se Mathias < 18 | requer_despacho = só aparece no modo com mala | so_despacho = existe, mas é barrado na bagagem de mão",
    "pesos": "peso_g é o peso de UMA unidade, em gramas. peso_g_merino substitui quando o ajuste merino está ligado.",
    "veste_no_voo": "true = uma unidade deste item vai vestida no avião e não pesa na bagagem, quando o ajuste 'Vestir muda no voo' está ligado.",
    "opcional": "true = item aparece na lista como lembrete, mas o peso NÃO entra na conta das bagagens.",
    "pessoa": "m = jovem | z = adulto | ausente = compartilhado entre os dois"
  },
